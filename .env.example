# Copy to .env and fill in the secrets.  Never commit the real .env.

# ---------------------------------------------------------------------------
# LLM: deepseek or zhipu (OpenAI-compatible chat endpoint)
# ---------------------------------------------------------------------------
# https://platform.deepseek.com/
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=32768
LLM_THINKING=disabled

# ---------------------------------------------------------------------------
# Zhipu chat + embeddings
# ---------------------------------------------------------------------------
# https://bigmodel.cn/apikey/platform
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
# Non-reasoning chat model used when LLM_PROVIDER=zhipu.
ZHIPU_CHAT_MODEL=glm-4-plus
EMBEDDING_MODEL=embedding-3
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=16

# ---------------------------------------------------------------------------
# Chroma / Redis / PostgreSQL
# ---------------------------------------------------------------------------
CHROMA_DIR=./chroma_db
CHROMA_HOST=localhost
CHROMA_PORT=8000
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+asyncpg://postgres:123456@localhost:5432/bidding

# Windows system proxy must not intercept localhost calls.
NO_PROXY=localhost,127.0.0.1
no_proxy=localhost,127.0.0.1

# ---------------------------------------------------------------------------
# HTTP API and task backend
# ---------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8001
API_MAX_UPLOAD_MB=200

# celery: Redis job state + Celery worker (default, survives API restarts).
# memory: in-process thread pool, single API process, no Redis; for tests/dev.
TASK_BACKEND=celery

# Job records and progress expire after this many seconds (Redis TTL);
# 0 disables expiry. The default keeps finished results for one day.
API_JOB_TTL_SECONDS=86400

# The two settings below only apply to TASK_BACKEND=memory.
API_JOB_WORKERS=2
API_MAX_JOBS=100

# Celery shares the Redis instance above. Job state uses REDIS_URL; Celery
# stores only small task return values in the result backend.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_RESULT_EXPIRES=86400
# Extraction of a long document can take a while; these are worker limits.
CELERY_TASK_TIME_LIMIT=7200
CELERY_SOFT_TIME_LIMIT=6900
# Windows requires --pool=solo on the worker command line; see README.

# ---------------------------------------------------------------------------
# MinerU cloud parsing
# ---------------------------------------------------------------------------
# https://mineru.net/apiManage/token  (API keys expire after ~90 days)
MINERU_MODE=cloud
MINERU_API_KEY=
# Single-file endpoint only accepts public URLs; local files use the batch flow.
MINERU_ENDPOINT=https://mineru.net/api/v4/extract/task
MINERU_BATCH_UPLOAD_ENDPOINT=https://mineru.net/api/v4/file-urls/batch
MINERU_BATCH_RESULT_ENDPOINT=https://mineru.net/api/v4/extract-results/batch/{batch_id}
MINERU_TIMEOUT=180
MINERU_DOWNLOAD_TIMEOUT=300
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL=5
MINERU_MAX_POLLS=120
MINERU_MAX_RETRIES=2
MINERU_RETRY_BACKOFF=2.0
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_MAX_FILE_MB=200
MINERU_MAX_PAGES=200

# ---------------------------------------------------------------------------
# Extraction / indexing tuning
# ---------------------------------------------------------------------------
EXTRACT_MAX_CHARS=12000
EXTRACT_BISECT_MIN_CHARS=1200
EXTRACT_BISECT_MAX_DEPTH=2
CHUNK_TARGET_CHARS=450
CHUNK_HARD_MAX_CHARS=700
CHUNK_OVERLAP_CHARS=80
INGEST_BATCH_SIZE=64
